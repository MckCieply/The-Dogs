# Copy this file to .env and fill in the values
# The .env file is gitignored — never commit secrets

# PostgreSQL (used by docker-compose and local backend)
DB_URL=jdbc:postgresql://localhost:5432/thedogs
DB_USERNAME=thedogs
DB_PASSWORD=thedogs

# JWT signing secret — must be at least 32 characters (256 bits) for HS256
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-secret-at-least-256-bits-long

# Cloudflare Tunnel token — required in production only
# Get from: Cloudflare Zero Trust dashboard → Access → Tunnels → Create tunnel
CLOUDFLARE_TUNNEL_TOKEN=
